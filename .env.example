# ── General ─────────────────────────────────────────────
NODE_ENV=development
TZ_DISPLAY=America/Santiago
API_PORT=8787
WEB_PORT=5173
LOG_LEVEL=info

# dry-run (default, no publica nada) | live (publica de verdad)
PUBLISH_MODE=dry-run

# ── Base de datos: Neon (ver docs/09-alta-neon-r2.md) ───
# Conexión DIRECTA: el host NO debe contener "-pooler".
# El pooler (PgBouncer, modo transacción) rompe pg-boss y drizzle-kit.
# Termina en ?sslmode=require (sin channel_binding).
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ── Archivos: Cloudflare R2 (API S3) ────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agentsales-media
SIGNED_URL_TTL_SECONDS=3600

# ── Seguridad ───────────────────────────────────────────
# Texto aleatorio de al menos 32 caracteres (por ejemplo 44 alfanuméricos
# de tu gestor de contraseñas, o: openssl rand -base64 32).
# Se derivan 32 bytes con HKDF-SHA256 para cifrar tokens en reposo (desde F3).
APP_ENCRYPTION_KEY=

# ── IA (F2) ─────────────────────────────────────────────
# claude-cli (usa tu plan Max, solo uso propio) | anthropic-api | fake
LLM_PROVIDER=claude-cli
LLM_MODEL=sonnet
# Solo con LLM_PROVIDER=anthropic-api (F7). La CLI de Claude nunca la recibe.
ANTHROPIC_API_KEY=
# Ejecutable de la CLI de Claude y tope de cada llamada, en segundos (de 10 a 600)
CLAUDE_CLI_PATH=claude
LLM_TIMEOUT_SECONDS=180

# ── Medios (F1-F2) ──────────────────────────────────────
MAX_VIDEO_MB=300
# Tope de una subida al panel (Excel + zip de medios), en MB
MAX_IMPORT_UPLOAD_MB=512
# ffmpeg 8.1 o más nuevo (arma las fotos HEIC del iPhone) y ffprobe (mide los videos)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Instagram (F3) ──────────────────────────────────────
# El par de la app de Instagram: Casos de uso > Administrar mensajes y contenido en Instagram >
# Personalizar > Configuración de la API con el inicio de sesión de Instagram. NO el identificador
# general de la app (Configuración > Información básica). Ver docs/integraciones/instagram.md §2.1
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta no acepta http://localhost como dirección de retorno: en F3 la cuenta se conecta con el
# token del panel (spec F3, D4); el OAuth se usa en F7, con https://
INSTAGRAM_REDIRECT_URI=http://localhost:8787/oauth/instagram/callback

# ── Mercado Libre / Portal Inmobiliario (F4) ────────────
# El par de tu app en developers.mercadolibre.cl > Mis aplicaciones. El sitio es fijo (MLC, Chile).
# Ver docs/07-checklist-cuentas.md y docs/integraciones/mercadolibre.md §3
ML_APP_ID=
ML_CLIENT_SECRET=
# Solo https:// y la MISMA registrada en la app (comparación exacta). No necesita cargar: después
# de autorizar, copias la dirección de la barra y la pegas en la CLI (spec F4 §4.2). El panel de
# Mercado Libre rechaza https://localhost: .test es un dominio reservado que nunca resuelve
ML_REDIRECT_URI=https://agentsales.test/oauth/mercadolibre/callback

# ── Facebook Marketplace (F5) ───────────────────────────
# Avisos por día y por cuenta (spec F5, D8)
MARKETPLACE_DAILY_LIMIT=3
# Perfiles del navegador (guardan la sesión de Facebook): FUERA del proyecto. Ruta absoluta o con
# ~/; una dentro del proyecto se rechaza. Por defecto ~/.agentsales/browser-profiles
BROWSER_PROFILES_DIR=~/.agentsales/browser-profiles
# Token de la API BDE del Banco Central, para el valor de la UF (gratis, dura 1 año). Sin él, los
# avisos en UF no van a Marketplace. Ver docs/integraciones/uf.md §3.1 y docs/07-checklist-cuentas.md
BCCH_API_TOKEN=
# Minutos que la ventana de Marketplace espera tu clic final antes de cerrarse (1 a 240)
MARKETPLACE_CONFIRM_TIMEOUT_MIN=30
