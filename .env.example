# ── General ─────────────────────────────────────────────
NODE_ENV=development
TZ_DISPLAY=America/Santiago
API_PORT=8787
WEB_PORT=5173
LOG_LEVEL=info

# dry-run (default, no publica nada) | live (publica de verdad)
PUBLISH_MODE=dry-run

# ── Supabase ────────────────────────────────────────────
# Usa el "Session pooler" (puerto 5432) o la conexión directa.
# NO uses el "Transaction pooler" (6543): rompe pg-boss y drizzle-kit.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
SIGNED_URL_TTL_SECONDS=3600

# ── Seguridad ───────────────────────────────────────────
# Genera con: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── IA (F2) ─────────────────────────────────────────────
# claude-cli (usa tu plan Max, solo uso propio) | anthropic-api | fake
LLM_PROVIDER=claude-cli
LLM_MODEL=sonnet
ANTHROPIC_API_KEY=

# ── Medios (F1-F2) ──────────────────────────────────────
MAX_VIDEO_MB=300
FFMPEG_PATH=ffmpeg

# ── Instagram (F3) ──────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8787/oauth/instagram/callback

# ── Mercado Libre / Portal Inmobiliario (F4) ────────────
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_SITE_ID=MLC

# ── Facebook Marketplace (F5) ───────────────────────────
MARKETPLACE_DAILY_LIMIT=3
BROWSER_PROFILES_DIR=./.browser-profiles
