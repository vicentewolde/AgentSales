{
  "name": "agentsales",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agentsales/api --filter @agentsales/worker --filter @agentsales/web dev",
    "check": "biome check . && tsc -b && vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @agentsales/web exec vite build",
    "db:generate": "pnpm --filter @agentsales/db generate",
    "db:migrate": "pnpm --filter @agentsales/db migrate",
    "db:seed": "pnpm --filter @agentsales/db seed",
    "db:backup": "pnpm --filter @agentsales/db backup",
    "auth:admin": "pnpm --silent --filter @agentsales/db run auth-admin",
    "db:dev-scrub": "pnpm --silent --filter @agentsales/db run dev-scrub",
    "storage:check": "pnpm --filter @agentsales/storage check",
    "music:upload": "pnpm --silent --filter @agentsales/storage run music:upload",
    "worker:ping": "pnpm --filter @agentsales/worker run job:ping",
    "cli": "pnpm --silent --filter @agentsales/cli run cli",
    "llm:smoke": "pnpm --filter @agentsales/llm run smoke",
    "eval:content": "pnpm --silent --filter @agentsales/worker run eval:content",
    "eval:social": "pnpm --silent --filter @agentsales/worker run eval:social",
    "ig:smoke": "pnpm --silent --filter @agentsales/worker run ig:smoke",
    "fb:smoke": "pnpm --silent --filter @agentsales/worker run fb:smoke",
    "uf:smoke": "pnpm --silent --filter @agentsales/worker run uf:smoke",
    "ml:smoke": "pnpm --silent --filter @agentsales/worker run ml:smoke",
    "ml:test-user": "pnpm --silent --filter @agentsales/worker run ml:test-user"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
