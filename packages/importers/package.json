{
  "name": "@agentsales/importers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@agentsales/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./staging": {
      "@agentsales/source": "./src/staging.ts",
      "types": "./dist/src/staging.d.ts",
      "default": "./dist/src/staging.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@agentsales/core": "workspace:*",
    "exceljs": "4.4.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@agentsales/db": "workspace:*",
    "@types/yauzl": "3.4.0"
  }
}
