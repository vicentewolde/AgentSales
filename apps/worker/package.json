{
  "name": "@agentsales/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "NODE_OPTIONS=--conditions=@agentsales/source tsx watch src/worker.ts",
    "start": "node dist/src/worker.js",
    "job:ping": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/ping.ts"
  },
  "dependencies": {
    "@agentsales/config": "workspace:*",
    "@agentsales/core": "workspace:*",
    "@agentsales/db": "workspace:*",
    "@agentsales/importers": "workspace:*",
    "@agentsales/llm": "workspace:*",
    "@agentsales/media": "workspace:*",
    "@agentsales/queue": "workspace:*",
    "@agentsales/storage": "workspace:*",
    "@agentsales/templates": "workspace:*",
    "zod": "4.6.5"
  }
}
