{
  "name": "@agentsales/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "NODE_OPTIONS=--conditions=@agentsales/source tsx watch src/worker.ts",
    "start": "node dist/src/worker.js",
    "job:ping": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/ping.ts",
    "eval:content": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/eval-content.ts",
    "ig:smoke": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/ig-smoke.ts",
    "fb:smoke": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/fb-smoke.ts",
    "ml:smoke": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/ml-smoke.ts",
    "ml:test-user": "NODE_OPTIONS=--conditions=@agentsales/source tsx src/scripts/ml-test-user.ts"
  },
  "dependencies": {
    "@agentsales/config": "workspace:*",
    "@agentsales/core": "workspace:*",
    "@agentsales/db": "workspace:*",
    "@agentsales/importers": "workspace:*",
    "@agentsales/llm": "workspace:*",
    "@agentsales/media": "workspace:*",
    "@agentsales/publishers": "workspace:*",
    "@agentsales/queue": "workspace:*",
    "@agentsales/storage": "workspace:*",
    "@agentsales/templates": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "msw": "3.0.0"
  }
}
