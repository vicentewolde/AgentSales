{
  "name": "@agentsales/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@agentsales/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "NODE_OPTIONS=--conditions=@agentsales/source tsx watch src/server.ts",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@agentsales/config": "workspace:*",
    "@agentsales/core": "workspace:*",
    "@agentsales/db": "workspace:*",
    "@agentsales/queue": "workspace:*",
    "@agentsales/storage": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.10"
  }
}
